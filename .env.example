# CIS 515 Workflow Observatory: environment variable NAMES only.
# Copy to .env.local (git-ignored) and fill in locally. Never put a real value in this file.
# Production secrets live in n8n Credentials or the deployment's secret store, not here.
# Never create any of these as NEXT_PUBLIC_*: none of them may reach the browser.

# Yellowdig (read-only Engage API; header "apikey")
YELLOWDIG_API_KEY=
YELLOWDIG_API_BASE_URL=https://data.yellowdig.app
YELLOWDIG_NETWORK=carey-school-of-business
YELLOWDIG_COMMUNITY_ID=6acd2896-76e7-400f-9a00-cfd657470859

# n8n (REST API key is private; the website never uses it)
N8N_BASE_URL=
N8N_API_KEY=

# Application / course
APP_TIMEZONE=America/Phoenix
CIS515_DEFAULT_WEEK=4

# Future AI providers (Phase 4)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Future GitHub publishing (Phase 5; fine-grained token, Contents permission on this repo only)
GITHUB_TOKEN=
GITHUB_OWNER=Rithikroyt
GITHUB_REPO=CIS-515-Weekly-Yellowdig-Posts-Newsletter
GITHUB_BRANCH=main

# Future human review
REVIEWER_EMAIL=

# Future website -> n8n production webhooks (authenticated with N8N_WEBHOOK_SECRET, never the n8n API key)
N8N_GENERATE_WEBHOOK_URL=
N8N_REVIEW_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Future pseudonymization (32+ characters; also stored server-side for n8n)
PSEUDONYMIZATION_SALT=

# Optional: local Docker sandbox only (n8n/docker-compose.yml)
GENERIC_TIMEZONE=America/Phoenix
