      "title": "Support Reply Desk",
      "author": {
        "id": "u_4336bff27e7d",
        "displayName": "Drew Patel"
      },
      "createdAt": "2026-10-26T16:00:00Z",
      "body": "A writer drafts a support reply from our policy, a judge scores it, and code flags risky tickets such as refunds over $100. A person approves every reply in Telegram before it is sent.\n\nIn one test the judge gave 9/10 to a reply that promised a refund over the limit. The code flag caught it.",
      "sourceUrl": null,
      "source": {
        "provider": "synthetic-fixture",
        "sourcePostId": "syn-w2-p05",
        "communityId": "6acd2896-76e7-400f-9a00-cfd657470859",
        "sourceUrlVerified": false
      },
      "comments": [
        {
          "commentId": "syn-w2-p05-c1",
          "parentId": "syn-w2-p05",
          "author": {
            "id": "u_320305e7daad",
            "displayName": "Sam Rivera"
          },
          "createdAt": "2026-10-26T16:35:00Z",
          "body": "This is the strongest argument for code gates I have seen this week."
        },
        {
          "commentId": "syn-w2-p05-c2",
          "parentId": "syn-w2-p05",
          "author": {
            "id": "u_81dac53ff9c9",
            "displayName": "Blake Torres"
          },
          "createdAt": "2026-10-26T17:00:00Z",
          "body": "Does the judge see the risk flag?"
        },
        {
          "commentId": "syn-w2-p05-c3",
          "parentId": "syn-w2-p05",
          "author": {
            "id": "u_4336bff27e7d",
            "displayName": "Drew Patel"
          },
          "createdAt": "2026-10-26T17:20:00Z",
          "body": "Not yet. I want to see whether it notices on its own first."
        }
      ],
