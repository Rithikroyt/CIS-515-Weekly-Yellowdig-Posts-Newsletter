{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cis515-observatory/schemas/workflow-profile.schema.json",
  "title": "WorkflowProfile",
  "description": "Deterministic static analysis of one n8n workflow JSON file. The workflow is never executed. No credentials, prompts, code, emails or parameter payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profileId", "assetId", "postRef", "workflowName", "nodeCount", "edgeCount", "triggerCount",
    "disabledNodeCount", "danglingEdgeCount", "nodeTypes", "nodeCategories", "capabilities", "retry", "scoreThreshold",
    "integrations", "aiProviders", "graph", "chips", "security", "source"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "profileId": { "type": "string", "pattern": "^wf_[a-f0-9]{12}$" },
    "assetId": { "type": "string", "pattern": "^asset_[a-f0-9]{16}$" },
    "postRef": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "workflowName": { "type": "string", "maxLength": 120 },
    "nodeCount": { "$ref": "#/$defs/count" },
    "edgeCount": { "$ref": "#/$defs/count" },
    "triggerCount": { "$ref": "#/$defs/count" },
    "disabledNodeCount": { "$ref": "#/$defs/count" },
    "danglingEdgeCount": { "$ref": "#/$defs/count" },
    "nodeTypes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "count"],
        "properties": { "type": { "$ref": "#/$defs/nodeType" }, "count": { "$ref": "#/$defs/count" } }
      }
    },
    "nodeCategories": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "count"],
        "properties": { "category": { "$ref": "#/$defs/category" }, "count": { "$ref": "#/$defs/count" } }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usesAI", "usesMultipleAgents", "usesCode", "usesHumanApproval", "usesExternalAPI", "usesEmail", "usesDataStore",
        "usesRetry", "hasBoundedRetry", "hasExplicitFailureHandling", "hasValidationGate", "hasCodeValidation",
        "usesLLMJudge", "hasFallback", "usesRAG", "usesMemory"
      ],
      "properties": {
        "usesAI": { "type": "boolean" },
        "usesMultipleAgents": { "type": "boolean" },
        "usesCode": { "type": "boolean" },
        "usesHumanApproval": { "type": "boolean" },
        "usesExternalAPI": { "type": "boolean" },
        "usesEmail": { "type": "boolean" },
        "usesDataStore": { "type": "boolean" },
        "usesRetry": { "type": "boolean" },
        "hasBoundedRetry": { "type": "boolean" },
        "hasExplicitFailureHandling": { "type": "boolean" },
        "hasValidationGate": { "type": "boolean" },
        "hasCodeValidation": { "type": "boolean" },
        "usesLLMJudge": { "type": "boolean" },
        "hasFallback": { "type": "boolean" },
        "usesRAG": { "type": "boolean" },
        "usesMemory": { "type": "boolean" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycles", "boundedCycles", "nodeRetries", "maxAttempts"],
      "properties": {
        "cycles": { "$ref": "#/$defs/count" },
        "boundedCycles": { "$ref": "#/$defs/count" },
        "nodeRetries": { "$ref": "#/$defs/count" },
        "maxAttempts": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "scoreThreshold": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": "number" } } },
        { "type": "null" }
      ]
    },
    "integrations": { "type": "array", "maxItems": 60, "items": { "type": "string", "maxLength": 60 } },
    "aiProviders": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 60 } },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "type", "category", "disabled"],
            "properties": {
              "id": { "$ref": "#/$defs/nodeId" },
              "label": { "type": "string", "maxLength": 80 },
              "type": { "$ref": "#/$defs/nodeType" },
              "category": { "$ref": "#/$defs/category" },
              "disabled": { "type": "boolean" }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "sourceOutput", "targetInput", "kind"],
            "properties": {
              "source": { "$ref": "#/$defs/nodeId" },
              "target": { "$ref": "#/$defs/nodeId" },
              "sourceOutput": { "$ref": "#/$defs/count" },
              "targetInput": { "$ref": "#/$defs/count" },
              "kind": { "enum": ["main", "ai", "error"] }
            }
          }
        }
      }
    },
    "chips": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "label"],
        "properties": {
          "category": { "enum": ["trigger", "ai", "judge", "code", "validator", "gate", "approval", "action", "storage", "tool", "errorPath", "other"] },
          "label": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialReferencesDetected", "pinnedDataDetected", "executionDataDetected", "staticDataDetected", "binaryDataDetected",
        "webhookIdsRemoved", "webhookUrlsRedacted", "possibleSecretsDetected", "emailsDetected", "stringsTruncated"
      ],
      "properties": {
        "credentialReferencesDetected": { "$ref": "#/$defs/count" },
        "pinnedDataDetected": { "type": "boolean" },
        "executionDataDetected": { "type": "boolean" },
        "staticDataDetected": { "type": "boolean" },
        "binaryDataDetected": { "type": "boolean" },
        "webhookIdsRemoved": { "$ref": "#/$defs/count" },
        "webhookUrlsRedacted": { "$ref": "#/$defs/count" },
        "possibleSecretsDetected": { "$ref": "#/$defs/count" },
        "emailsDetected": { "$ref": "#/$defs/count" },
        "stringsTruncated": { "$ref": "#/$defs/count" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileMethod", "executed", "profilerVersion"],
      "properties": {
        "profileMethod": { "const": "deterministic-static-analysis" },
        "executed": { "const": false },
        "profilerVersion": { "type": "string", "maxLength": 20 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "count": { "type": "integer", "minimum": 0 },
    "nodeId": { "type": "string", "pattern": "^n[0-9]+$" },
    "nodeType": { "type": "string", "maxLength": 160 },
    "category": {
      "enum": [
        "trigger", "ai_model", "ai_agent", "ai_component", "code", "validation", "human_review", "email", "messaging",
        "http_api", "database", "data_store", "file", "spreadsheet", "calendar", "search_rss", "control_flow", "transform",
        "merge", "wait", "error_handling", "other"
      ]
    }
  }
}
