{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cis515-observatory/schemas/asset-manifest.schema.json",
  "title": "AssetManifest",
  "description": "Deterministic weekly manifest of manually supplied workflow assets with validation status. Nothing here is public until approved. No content and no local paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "week", "assets", "summary"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "week": { "type": "integer", "minimum": 1, "maximum": 16 },
    "assets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset", "status", "reason", "duplicateOf", "profileRef", "approval"],
        "properties": {
          "asset": { "$ref": "workflow-asset.schema.json" },
          "status": { "enum": ["PROFILED", "VALIDATED", "REJECTED", "DUPLICATE", "UNMATCHED_ASSET"] },
          "reason": { "oneOf": [{ "$ref": "#/$defs/reason" }, { "type": "null" }] },
          "duplicateOf": { "oneOf": [{ "$ref": "workflow-asset.schema.json#/$defs/assetId" }, { "type": "null" }] },
          "profileRef": { "oneOf": [{ "type": "string", "pattern": "^wf_[a-f0-9]{12}$" }, { "type": "null" }] },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": { "status": { "enum": ["pending", "approved", "rejected"] } }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "profiled", "validated", "rejected", "duplicates", "unmatched"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "profiled": { "type": "integer", "minimum": 0 },
        "validated": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "unmatched": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "reason": {
      "enum": [
        "INVALID_ASSET_METADATA", "UNSUPPORTED_FILE_TYPE", "MIME_MISMATCH", "CONTENT_MISMATCH", "EMPTY_FILE",
        "WORKFLOW_TOO_LARGE", "IMAGE_TOO_LARGE", "TOO_MANY_FILES_FOR_POST", "BATCH_LIMIT_EXCEEDED",
        "INVALID_JSON", "JSON_TOO_DEEP", "NOT_N8N_WORKFLOW", "TOO_MANY_NODES", "TOO_MANY_EDGES",
        "UNSUPPORTED_STRUCTURE", "SECRET_POLICY_FAILURE", "DUPLICATE_CONTENT", "NO_POST_REFERENCE", "UNKNOWN_POST_REFERENCE"
      ]
    }
  }
}
